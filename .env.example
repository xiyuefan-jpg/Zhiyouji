# Server (apps/server/src/config.ts, main.ts). Copy to .env on the server; never commit the real one.
NODE_ENV=production
# Long random string: signs sessions, upload tickets and download links. Required in production.
SERVER_SECRET=
# Aliyun RDS PostgreSQL. Without it the server uses an embedded PGlite database in PGLITE_DIR (development only).
DATABASE_URL=postgres://zhiyouji:PASSWORD@HOST:5432/zhiyouji
# Version of the three documents; changing it asks every parent to confirm again.
POLICY_VERSION=2027-01
PORT=3000
# 1 when nginx / SLB is in front (real client IPs for rate limits).
TRUST_PROXY=1
# Worker pass interval in ms.
TICK_MS=30000
# Until Aliyun OSS is connected, uploaded files are kept here (mount a disk).
STORAGE_DIR=/data/storage
